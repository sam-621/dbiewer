{
  "name": "@dbiewer/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc && tsup",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:e2e": "scripts/test-database.sh vitest.e2e.config.ts",
    "test:integration": "scripts/test-database.sh vitest.integration.config.ts",
    "lint:check": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "gen:types": "graphql-codegen --config codegen.ts",
    "migrate:make": "drizzle-kit generate --name",
    "migrate": "tsx scripts/migrate.ts",
    "emails": "email dev --dir ./src/services/emails/templates"
  },
  "dependencies": {
    "@graphql-tools/load-files": "^8.0.6",
    "@graphql-tools/schema": "^11.0.6",
    "@react-email/components": "^1.0.12",
    "better-auth": "^1.7.12",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "slugify": "^1.6.9",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@react-email/preview-server": "5.2.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "react-email": "5.2.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

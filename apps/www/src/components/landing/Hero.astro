---
import { APP_URL, GITHUB_URL } from '../../config';
import DiagramView from '../app/DiagramView.astro';
import Icon from '../app/Icon.astro';
import SqlView from '../app/SqlView.astro';
import LinkButton from '../ui/LinkButton.astro';
---

<main class="mx-auto grid w-full max-w-[1200px] flex-1 grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-center gap-12 px-6 py-6 max-[960px]:grid-cols-1 max-[960px]:gap-10 max-sm:px-4">
  <div class="flex flex-col items-start gap-6">
    <h1 class="m-0 min-w-0 text-[clamp(40px,5.4vw,68px)] leading-[1] font-semibold tracking-[-0.035em] text-balance break-words">
      Query Postgres from your browser.
    </h1>
    <p class="m-0 max-w-[36ch] text-lg leading-relaxed text-muted-foreground">
      Open source, free, no subscriptions. Use it here or host your own.
    </p>
    <div class="flex flex-wrap items-center gap-2">
      <LinkButton href={APP_URL} size="lg">
        Open app
      </LinkButton>
      <LinkButton href={GITHUB_URL} variant="outline" size="lg">
        <Icon name="github" class="size-4" />
        View on GitHub
      </LinkButton>
    </div>
  </div>

  <div class="relative h-[560px] max-[960px]:h-auto">
    <DiagramView class="absolute top-0 right-0 h-[330px] w-[90%] max-[960px]:hidden" />
    <SqlView class="absolute bottom-0 left-0 h-[340px] w-[78%] max-[960px]:static max-[960px]:w-full" />
  </div>
</main>

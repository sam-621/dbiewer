---
import { APP_URL } from '../../config';
import HeroShot from '../mockups/HeroShot.astro';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden px-6 pt-20 pb-10 max-sm:px-4 max-sm:pt-14">
  <div class="hero-dots absolute inset-0 opacity-60"></div>
  <div class="hero-glow pointer-events-none absolute top-0 left-1/2 h-[500px] w-[800px] -translate-x-1/2"></div>

  <div class="relative mx-auto flex max-w-[1100px] flex-col items-center gap-7 text-center">
    <h1 class="m-0 max-w-[940px] text-[clamp(38px,6.2vw,72px)] leading-[1.02] font-semibold tracking-[-0.03em] text-balance">
      See your schema.
      <br />
      Query it. <em class="font-serif font-normal text-accent">Ask it.</em>
    </h1>

    <p class="m-0 max-w-[600px] text-[17px] leading-[1.55] text-pretty text-fg-2">
      A visual workspace for Postgres, MySQL and SQLite. Connect your database in 30 seconds — get a
      live canvas of every table, an SQL playground with real autocomplete, and an AI that knows
      your schema.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-2.5">
      <Button href={APP_URL} variant="primary" kbd="→">
        Connect a database
      </Button>
      <Button href={APP_URL} variant="ghost">
        See a demo
      </Button>
    </div>

    <div class="mt-1.5 flex flex-wrap items-center justify-center gap-x-[22px] gap-y-1 text-[11.5px] text-fg-3 [&_b]:font-medium [&_b]:text-fg-2">
      <span>
        <b>Free</b> for solo use
      </span>
      <span class="text-fg-4">·</span>
      <span>
        <b>AI-first</b> SQL assistant
      </span>
      <span class="text-fg-4">·</span>
      <span>Postgres · MySQL · SQLite</span>
    </div>

    <HeroShot />
  </div>
</section>

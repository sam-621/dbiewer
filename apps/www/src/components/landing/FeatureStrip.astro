---
import { Code, Database, Sparkles, Table } from 'lucide-react';

const items = [
  {
    title: 'Live schema canvas',
    text: 'Every table, view and FK relationship laid out automatically.',
    icon: Database
  },
  {
    title: 'SQL with brains',
    text: 'Autocomplete for your tables, columns and joins. Run with ⌘↵.',
    icon: Code
  },
  {
    title: 'AI that knows your DB',
    text: 'Ask in plain language, get SQL grounded in your real schema.',
    icon: Sparkles
  },
  {
    title: 'Spreadsheet view',
    text: 'Open any table in fullscreen. Filter, sort, edit cells.',
    icon: Table
  }
];
---

<section class="relative px-6 pb-20 max-sm:px-4">
  <div class="mx-auto grid max-w-[1100px] grid-cols-4 gap-px overflow-hidden rounded-2xl border bg-border max-[900px]:grid-cols-2 max-sm:grid-cols-1">
    {items.map(({ title, text, icon: Icon }) => (
      <div class="flex flex-col gap-1.5 bg-card px-5 py-[18px]">
        <div class="mb-0.5 grid size-7 place-items-center rounded-md bg-primary/14 text-primary">
          <Icon className="size-3.5" strokeWidth={1.7} />
        </div>
        <div class="text-[13px] font-semibold text-foreground">{title}</div>
        <div class="text-xs leading-normal text-muted-foreground">{text}</div>
      </div>
    ))}
  </div>
</section>

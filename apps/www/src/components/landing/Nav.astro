---
import { APP_URL, GITHUB_URL } from '../../config';
import Icon from '../app/Icon.astro';
import Brand from '../ui/Brand.astro';
import LinkButton from '../ui/LinkButton.astro';
---

<header class="mx-auto flex w-full max-w-[1200px] items-center gap-4 px-6 py-5 max-sm:px-4">
  <Brand />
  <nav class="ml-auto flex items-center gap-1.5" aria-label="Main">
    <LinkButton href={GITHUB_URL} variant="ghost">
      <Icon name="github" class="size-4" />
      GitHub
    </LinkButton>
    <LinkButton href={APP_URL}>Open app</LinkButton>
  </nav>
</header>

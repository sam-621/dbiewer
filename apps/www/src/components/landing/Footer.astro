---
import Brand from '../ui/Brand.astro';

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '#features' },
      { label: 'Pricing', href: '#pricing' },
      { label: 'Changelog', href: '#' },
      { label: 'Roadmap', href: '#' }
    ]
  },
  {
    title: 'Developers',
    links: [
      { label: 'Docs', href: '#' },
      { label: 'CLI', href: '#' },
      { label: 'DBML export', href: '#' },
      { label: 'Status', href: '#' }
    ]
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '#' },
      { label: 'Contact', href: '#' },
      { label: 'Privacy', href: '#' },
      { label: 'Terms', href: '#' }
    ]
  }
];

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-bg px-6 pt-12 pb-9 max-sm:px-4">
  <div class="mx-auto grid max-w-[1100px] grid-cols-[2fr_1fr_1fr_1fr] gap-8 max-[900px]:grid-cols-2">
    <div class="max-[900px]:col-span-2">
      <Brand />
      <p class="mt-2 mb-0 max-w-[280px] text-[13px] leading-[1.55] text-fg-3">
        The visual workspace for your databases. Built by developers who got tired of psql tabs.
      </p>
    </div>
    {columns.map(column => (
      <div>
        <h5 class="m-0 mb-3 text-[10.5px] font-semibold tracking-[0.08em] text-fg-4 uppercase">
          {column.title}
        </h5>
        <ul class="m-0 flex list-none flex-col gap-2 p-0">
          {column.links.map(link => (
            <li>
              <a href={link.href} class="text-[13px] text-fg-2 hover:text-fg">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="mx-auto mt-9 flex max-w-[1100px] flex-wrap items-center justify-between gap-3 border-t border-line-soft pt-6 font-mono text-[11.5px] text-fg-4">
    <span>© {year} dbiewer · made in CDMX</span>
    <div class="flex gap-4">
      <span>v0.1.0</span>
      <span>● all systems operational</span>
    </div>
  </div>
</footer>

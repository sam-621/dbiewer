---
import { GITHUB_URL } from '../../config';

const year = new Date().getFullYear();
---

<footer class="mx-auto flex w-full max-w-[1200px] items-center justify-between gap-4 px-6 py-5 text-sm text-muted-foreground max-sm:px-4">
  <span>© {year} dbiewer</span>
  <a
    href={GITHUB_URL}
    class="rounded-sm hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring"
  >
    Source on GitHub
  </a>
</footer>

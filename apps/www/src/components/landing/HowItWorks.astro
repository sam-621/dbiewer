---
import { Card, CardDescription, CardHeader, CardTitle } from '../ui/card';
import SectionHead from '../ui/SectionHead.astro';

const steps = [
  {
    label: '01 / connect',
    title: 'Paste a connection URI.',
    text: 'Postgres, MySQL or SQLite. We test the connection, pick the schemas to index, and store credentials encrypted.'
  },
  {
    label: '02 / explore',
    title: 'Get a canvas of your DB.',
    text: "Every table, every FK. Drag them around, click into a table, hide the noise. It's your map."
  },
  {
    label: '03 / ask',
    title: 'Query or ask.',
    text: 'Write SQL with autocomplete or describe what you want in plain English — dbiewer writes it grounded in your real schema.'
  }
];
---

<section id="how" class="relative border-y bg-muted/40 px-6 py-[100px] max-sm:px-4">
  <div class="mx-auto max-w-[1100px]">
    <SectionHead eyebrow="three steps">
      From connection string <em>to insight,</em> in under a minute.
    </SectionHead>

    <div class="mt-9 grid grid-cols-3 gap-3 max-[900px]:grid-cols-1">
      {steps.map(step => (
        <Card>
          <CardHeader className="gap-2 p-[22px]">
            <span class="font-mono text-[11px] font-semibold text-primary">{step.label}</span>
            <CardTitle className="text-[17px] leading-tight tracking-[-0.01em]">
              {step.title}
            </CardTitle>
            <CardDescription className="text-[13px] leading-[1.55]">{step.text}</CardDescription>
          </CardHeader>
        </Card>
      ))}
    </div>
  </div>
</section>

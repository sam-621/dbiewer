---
import SectionHead from '../ui/SectionHead.astro';
import { FaqList } from './FaqList';
---

<section class="relative border-y bg-muted/40 px-6 py-[100px] max-sm:px-4">
  <div class="mx-auto max-w-[1100px]">
    <SectionHead eyebrow="questions">
      Things people ask <em>before connecting.</em>
    </SectionHead>

    <FaqList client:visible />
  </div>
</section>

---
import Button from '../ui/Button.astro';

interface Price {
  amount: string;
  note: string;
}

interface Props {
  name: string;
  monthly: Price;
  annual?: Price;
  period: string;
  blurb: string;
  cta: string;
  href: string;
  flag?: string;
  featured?: boolean;
}

const {
  name,
  monthly,
  annual = monthly,
  period,
  blurb,
  cta,
  href,
  flag,
  featured = false
} = Astro.props;

const prices = [
  { price: monthly, visibility: 'group-data-[billing=annual]:hidden' },
  { price: annual, visibility: 'hidden group-data-[billing=annual]:block' }
];
---

<div
  class:list={[
    'relative flex flex-col gap-[18px] rounded-xl border p-7 max-sm:p-6',
    featured
      ? 'glow-corner border-accent-line shadow-[inset_0_0_0_1px_var(--color-accent-line),0_12px_40px_oklch(0_0_0/0.3)]'
      : 'border-line bg-bg'
  ]}
>
  <div class="flex items-center gap-2.5">
    <span class="text-base font-semibold tracking-[-0.01em]">{name}</span>
    {flag && (
      <span class="ml-auto rounded-[3px] bg-accent-soft px-2 py-0.5 text-[10px] font-semibold tracking-[0.04em] text-accent uppercase">
        {flag}
      </span>
    )}
  </div>
  {prices.map(({ price, visibility }) => (
    <div class={visibility}>
      <div class="flex items-baseline gap-1.5 font-mono">
        <span class="text-[44px] font-semibold tracking-[-0.02em] text-fg">{price.amount}</span>
        <span class="text-[13px] text-fg-3">/ {period}</span>
      </div>
      <div class="font-mono text-[11.5px] text-fg-4">{price.note}</div>
    </div>
  ))}
  <div class="text-[13px] leading-normal text-fg-3">{blurb}</div>
  <ul class="m-0 flex flex-1 list-none flex-col gap-[9px] p-0 [&_b]:font-medium [&_b]:text-fg [&_li]:flex [&_li]:items-start [&_li]:gap-[9px] [&_li]:text-[13px] [&_li]:leading-normal [&_li]:text-fg-2 [&_svg]:mt-1">
    <slot />
  </ul>
  <div class="mt-auto">
    <Button
      href={href}
      variant={featured ? 'primary' : 'default'}
      class="w-full justify-center py-[11px]!"
    >
      {cta}
    </Button>
  </div>
</div>

---
import AiVisual from '../mockups/AiVisual.astro';
import CanvasVisual from '../mockups/CanvasVisual.astro';
import GridVisual from '../mockups/GridVisual.astro';
import SqlVisual from '../mockups/SqlVisual.astro';
import CheckIcon from '../ui/CheckIcon.astro';
import Code from '../ui/Code.astro';
import SectionHead from '../ui/SectionHead.astro';
import Feature from './Feature.astro';
---

<section id="features" class="relative px-6 pb-[100px] max-sm:px-4">
  <div class="mx-auto max-w-[1100px]">
    <SectionHead
      eyebrow="the workspace"
      sub="Stop bouncing between psql, your ORM docs, and a screenshot of the schema someone sent you on Slack last year."
    >
      Everything your database needs <em>on one canvas.</em>
    </SectionHead>

    <Feature eyebrow="schema canvas" title="Your database as a map.">
      <Fragment slot="description">
        Connect once and dbiewer indexes every schema, table and foreign key. Drag tables around,
        snap to grid, hide what you don't need. Click a relation to follow it.
      </Fragment>
      <Fragment slot="bullets">
        <li>
          <CheckIcon />
          <span>Auto-layout that respects FK clusters</span>
        </li>
        <li>
          <CheckIcon />
          <span>
            Highlight columns marked <Code>PK</Code> · <Code>FK</Code> · <Code>NOT NULL</Code>
          </span>
        </li>
        <li>
          <CheckIcon />
          <span>Multi-schema with collapsible groups</span>
        </li>
        <li>
          <CheckIcon />
          <span>Export the canvas as PNG, SVG or DBML</span>
        </li>
      </Fragment>
      <CanvasVisual slot="visual" />
    </Feature>

    <Feature
      eyebrow="SQL playground"
      title="SQL with autocomplete that actually knows your tables."
      reverse
    >
      <Fragment slot="description">
        Not just keywords — column names, table aliases, join paths inferred from foreign keys.
        Cmd+Enter runs the statement under your cursor. Cmd+S saves it as a reusable query file.
      </Fragment>
      <Fragment slot="bullets">
        <li>
          <CheckIcon />
          <span>Multiple statements per tab, run the one at the cursor</span>
        </li>
        <li>
          <CheckIcon />
          <span>
            <Code>EXPLAIN ANALYZE</Code> rendered as a tree
          </span>
        </li>
        <li>
          <CheckIcon />
          <span>Saved queries with workspace-level sharing</span>
        </li>
        <li>
          <CheckIcon />
          <span>
            Results to CSV, JSON or a new <Code>VIEW</Code>
          </span>
        </li>
      </Fragment>
      <SqlVisual slot="visual" />
    </Feature>

    <Feature eyebrow="ai assistant" title="An assistant grounded in your schema.">
      <Fragment slot="description">
        Ask in plain English, in Spanish, whatever. The assistant has read access to your{' '}
        <Code>information_schema</Code> and writes SQL that references your real tables — no
        hallucinated columns.
      </Fragment>
      <Fragment slot="bullets">
        <li>
          <CheckIcon />
          <span>
            Every query is <b>Copy / Run / Open in editor</b>
          </span>
        </li>
        <li>
          <CheckIcon />
          <span>Per-table context — only sees what you explicitly attach</span>
        </li>
        <li>
          <CheckIcon />
          <span>Chats persist per workspace, searchable</span>
        </li>
        <li>
          <CheckIcon />
          <span>
            <b>Never</b> writes to your DB. Suggests, you decide.
          </span>
        </li>
      </Fragment>
      <AiVisual slot="visual" />
    </Feature>

    <Feature eyebrow="table view" title="The spreadsheet you wish your ORM had." reverse>
      <Fragment slot="description">
        Click any table to open it fullscreen with sorting, filtering, and inline editing. Foreign
        keys are clickable — jump straight to the referenced row. Edits go through review before
        they touch your database.
      </Fragment>
      <Fragment slot="bullets">
        <li>
          <CheckIcon />
          <span>
            Visual <Code>WHERE</Code> builder with type-aware chips
          </span>
        </li>
        <li>
          <CheckIcon />
          <span>Render JSON, dates and enums sensibly</span>
        </li>
        <li>
          <CheckIcon />
          <span>Cursor-based pagination, no offsets</span>
        </li>
      </Fragment>
      <GridVisual slot="visual" />
    </Feature>
  </div>
</section>

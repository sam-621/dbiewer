---
import { APP_URL } from '../../config';
import SectionHead from '../ui/SectionHead.astro';
import { PricingPlans } from './PricingPlans';
---

<section id="pricing" class="relative px-6 py-[100px] max-sm:px-4">
  <div class="mx-auto max-w-[1100px]">
    <SectionHead
      eyebrow="pricing"
      sub="No seats, no usage gotchas. Cancel anytime, your saved queries stay yours."
      class="mb-0!"
    >
      Free to start. <em>Pro when you need it.</em>
    </SectionHead>

    <PricingPlans client:load href={APP_URL} />

    <div class="mt-[22px] text-center font-mono text-[11.5px] text-muted-foreground/72">
      need more? team & enterprise plans with SSO, audit log, self-hosted option ·{' '}
      <a href="#" class="text-primary">
        talk to us →
      </a>
    </div>
  </div>
</section>

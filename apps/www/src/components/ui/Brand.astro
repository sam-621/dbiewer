---
import { Badge } from './badge';
import BrandMark from './BrandMark.astro';

interface Props {
  tag?: string;
}

const { tag } = Astro.props;
---

<a
  href="/"
  class="flex items-center gap-2 rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
>
  <BrandMark />
  <span class="text-[15px] font-semibold tracking-[-0.01em]">dbiewer</span>
  {tag && (
    <Badge variant="outline" className="font-mono">
      {tag}
    </Badge>
  )}
</a>

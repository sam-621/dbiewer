---
interface Props {
  size?: 'sm' | 'md';
}

const { size = 'md' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class:list={['shrink-0', size === 'md' ? 'size-6' : 'size-5']}
>
  <rect width="24" height="24" rx="6" class="fill-accent"></rect>
  <g class="stroke-accent-ink" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10.5 5V18.5H8.25A3.5 3.5 0 0 1 8.25 11.5H10.5"></path>
    <path d="M13.5 5V18.5H15.75A3.5 3.5 0 0 0 15.75 11.5H13.5"></path>
  </g>
</svg>

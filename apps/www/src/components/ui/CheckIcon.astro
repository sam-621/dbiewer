---
interface Props {
  strokeWidth?: number;
  class?: string;
}

const { strokeWidth = 2.4, class: className } = Astro.props;
---

<svg
  width="12"
  height="12"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0 text-accent', className]}
>
  <path d="M5 12.5 10 17l9-10"></path>
</svg>

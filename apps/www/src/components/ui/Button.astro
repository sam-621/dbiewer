---
interface Props {
  href: string;
  variant?: 'default' | 'primary' | 'ghost';
  size?: 'sm' | 'md';
  kbd?: string;
  class?: string;
}

const { href, variant = 'default', size = 'md', kbd, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center border font-medium',
    size === 'md'
      ? 'gap-[7px] rounded-lg px-[18px] py-2.5 text-[13.5px]'
      : 'gap-1.5 rounded-md px-3 py-1.5 text-[12.5px]',
    {
      'border-line bg-bg-elev text-fg hover:bg-bg-elev-2': variant === 'default',
      'border-transparent bg-accent font-semibold text-accent-ink hover:bg-accent-hover':
        variant === 'primary',
      'border-transparent bg-transparent text-fg hover:bg-bg-elev-2': variant === 'ghost'
    },
    className
  ]}
>
  <slot />
  {kbd && (
    <span
      class:list={[
        'grid place-items-center rounded-[3px] font-mono leading-none',
        size === 'md'
          ? 'h-[18px] min-w-[18px] px-1 text-[11px]'
          : 'h-4 min-w-4 px-[3px] text-[10px]',
        variant === 'primary' ? 'bg-accent-ink/12 text-accent-ink' : 'bg-bg-elev-2 text-fg-3'
      ]}
    >
      {kbd}
    </span>
  )}
</a>
